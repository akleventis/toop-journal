{
  "name": "toop-journal-electrobun",
  "version": "1.0.1",
  "type": "module",
  "scripts": {
    "build:renderer": "renderer/node_modules/.bin/esbuild renderer/src/main.ts --bundle --outfile=src/mainview/renderer.js --platform=browser",
    "build:jspdf": "renderer/node_modules/.bin/esbuild renderer/node_modules/jspdf/dist/jspdf.es.min.js --bundle --outfile=src/mainview/jspdf.bundle.js --platform=browser --format=esm",
    "build:css": "renderer/node_modules/.bin/tailwindcss -i renderer/src/index.css -o src/mainview/tailwind.css",
    "build:assets": "npm run build:renderer && npm run build:jspdf && npm run build:css",
    "dev": "npm run build:assets && bunx electrobun dev",
    "build": "npm run build:assets && bunx electrobun build",
    "package": "npm run build:assets && bunx electrobun package"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.850.0",
    "electrobun": "1.18.1"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "^5.8.3"
  }
}
