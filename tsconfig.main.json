{
  "compilerOptions": {
    "target": "ES2020",
    "module": "CommonJS",
    "outDir": "./dist/main",
    "rootDir": "./",
    "strict": true,
    "esModuleInterop": true,
    "moduleResolution": "Node",
    "resolveJsonModule": true,
    "skipLibCheck": true
  },
  "include": [
    "main/**/*.ts",
    "preload/**/*.ts",
    "shared/**/*.ts",
    "interface.d.ts"
  ]
}